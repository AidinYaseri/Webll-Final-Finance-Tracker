FROM node:18-alpine

WORKDIR /app

# Copy package files
COPY package.json package-lock.json ./

# Install dependencies
RUN npm ci

# Copy application code
COPY . .

# Build the app for production
RUN npm run build

# Expose port
EXPOSE 3000

# Start the app using preview (or you can use a simple HTTP server)
CMD ["npm", "run", "preview"]
